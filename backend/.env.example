# ---------------------------------------------------------------------------
# Bizentrix SchoolConnect - backend environment
#
# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. Real environment variables take precedence over this file.
# ---------------------------------------------------------------------------

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-schoolconnect-local-dev-secret-key-replace-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# PostgreSQL Database Configuration
DB_NAME=school_management
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration for Flutter
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Email SMTP Configuration (Gmail or other SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Meta WhatsApp Cloud API (optional - leave blank to disable WhatsApp OTP).
# With these unset and DEBUG=True the send is a no-op; the OTP is not printed.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_OTP_TEMPLATE=hello_world

# API rate limits (DRF ScopedRateThrottle)
THROTTLE_RATE_AUTH=10/min
THROTTLE_RATE_OTP=20/hour
